{
  "name": "resumematch-ph-server",
  "version": "1.0.0",
  "private": true,
  "description": "ResumeMatch PH \u2014 Node/Express API (port of api/*.php)",
  "type": "commonjs",
  "main": "dist/server.js",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:deploy": "npm ci --prefix ../client && npm run build --prefix ../client && npm run build",
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "test": "node -r ts-node/register/transpile-only --test tests/engine.test.ts",
    "check:config": "node -r ts-node/register/transpile-only scripts/check-config.ts",
    "create-admin": "node -r ts-node/register/transpile-only scripts/create-admin.ts",
    "test:api": "node -r ts-node/register/transpile-only --test tests/api.test.ts",
    "test:email": "node -r ts-node/register/transpile-only --test tests/email.test.ts",
    "test:analyze": "node -r ts-node/register/transpile-only --test tests/analyze.test.ts",
    "test:all": "npm test && npm run test:api && npm run test:email && npm run test:analyze && npm run test:parse && npm run test:parity && npm run test:storage",
    "test:parity": "node -r ts-node/register/transpile-only --test tests/mode-parity.test.ts",
    "test:parse": "node -r ts-node/register/transpile-only --test tests/parse-resume.test.ts",
    "test:storage": "node -r ts-node/register/transpile-only --test tests/storage.test.ts",
    "compare:readers": "node -r ts-node/register/transpile-only scripts/compare-readers.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "connect-pg-simple": "^10.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.6.0",
    "express-session": "^1.18.0",
    "helmet": "^8.3.0",
    "mammoth": "^1.12.0",
    "multer": "^2.0.0",
    "nodemailer": "^9.0.3",
    "pdfjs-dist": "^4.10.38",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.18.0",
    "@types/multer": "^1.4.11",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.3"
  }
}
