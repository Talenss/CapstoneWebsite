# Copy to .env and adjust for your machine. All values shown are the defaults
# baked into src/config.ts if a variable is left unset.

# ---------- Database (Supabase / PostgreSQL) ----------
# Easiest: paste your Supabase connection string here. Get it from
# Supabase → Project Settings → Database → Connection string →
# "Session pooler" (port 5432). SSL is required and turns on automatically
# whenever DATABASE_URL is set.
DATABASE_URL=

# Only used when DATABASE_URL is empty — e.g. a local PostgreSQL during
# development. Set DB_SSL=false for a plain local server.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=resumematch_ph
DB_USER=postgres
DB_PASS=
DB_SSL=

PORT=4300

# The Angular dev server origin (ng serve), so the session cookie's CORS
# policy allows it. Not needed in production if you serve the built Angular
# app from this same Node process (see server.ts).
ALLOW_ORIGIN=http://localhost:4200

# Change this to a long random string in production.
SESSION_SECRET=rmph-dev-secret-change-in-production

# Hides SQL error detail from API responses when false.
DEBUG=true

# ---------- Production hardening ----------
# Set BOTH to true when running behind an HTTPS reverse proxy (nginx,
# Caddy, a cloud host). TRUST_PROXY makes Express trust X-Forwarded-*
# headers (real client IPs for rate limiting); COOKIE_SECURE marks the
# session cookie HTTPS-only. Leave false for plain-http local use.
TRUST_PROXY=false
COOKIE_SECURE=false

# ---------- Email sending (verification + password reset) ----------
# Used to email the 6-digit codes for account verification and password
# reset. Any SMTP service works — see SETUP.md for free options (Gmail app
# password, Brevo). Leave empty during development: with DEBUG=true the
# code is printed to this console and shown in the page instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Optional; defaults to "ResumeMatch PH <SMTP_USER>".
MAIL_FROM=
# Public base URL of the site, used for the links inside notification
# emails (e.g. https://resumematch.example.com). Defaults to
# http://localhost:PORT for local development.
APP_URL=

# ---------- Reading an uploaded resume ----------
# Which reader turns an uploaded document into fields the engine can score.
#   rules   Pattern matching only (lib/parse-resume.ts). No AI, no network,
#           no key, and the applicant's document never leaves this server.
#           Reads plain single-column PDFs, .docx and .txt. Cannot read a
#           scan or a photo, and degrades on multi-column layouts.
#   gemini  Google's Gemini API (lib/extract.ts). Reads images and messy
#           layouts better, but sends the document to a third party.
#   auto    gemini when GEMINI_API_KEY is set, rules otherwise. The default.
#
# Set this to "rules" to run the whole system with no AI of any kind.
#
# THE STUDY RUNS ON "rules", AND THAT IS DELIBERATE. Pinned rather than left on
# "auto" so the reader cannot change because somebody happened to add a key: an
# applicant's document never leaves this server for the duration of the
# evaluation, which is the cleanest position available under the Data Privacy
# Act (RA 10173) and removes the cross-border transfer question entirely.
# The gemini reader stays implemented and tested; it is simply not enabled.
RESUME_EXTRACTOR=rules

# Only needed for the gemini reader. Get a FREE key at
# https://aistudio.google.com/apikey (Google AI Studio).
GEMINI_API_KEY=
# The model used for extraction (free tier includes this one).
GEMINI_MODEL=gemini-2.5-flash
