# Copy to .env and adjust for your machine. All values shown are the defaults
# baked into src/config.ts if a variable is left unset.

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=resumematch_ph
DB_USER=root
DB_PASS=

PORT=4300

# The Angular dev server origin (ng serve), so the session cookie's CORS
# policy allows it. Not needed in production if you serve the built Angular
# app from this same Node process (see server.ts).
ALLOW_ORIGIN=http://localhost:4200

# Change this to a long random string in production.
SESSION_SECRET=rmph-dev-secret-change-in-production

# Hides SQL error detail from API responses when false.
DEBUG=true

# ---------- AI resume analysis (optional) ----------
# Powers the "Upload & analyze my resume" feature. Get a FREE key at
# https://aistudio.google.com/apikey (Google AI Studio). Without a key the
# feature shows a friendly "not configured" message; the rest of the site
# is unaffected.
GEMINI_API_KEY=
# The model used for extraction (free tier includes this one).
GEMINI_MODEL=gemini-2.5-flash
