# ============================================================
# ResumeMatch PH — server environment
# NOT COMMITTED. Listed in server/.gitignore line 3; keep it that way.
#
# Every variable the server code actually reads is below. Values shown are
# the defaults baked into src/config.ts when a variable is left blank.
# ============================================================


# ============================================================
# 1 · DATABASE — Supabase (project mzrdwaicehbrdpveldwm)
# ============================================================
# When DATABASE_URL is set, db.ts uses it and ignores DB_HOST/DB_PORT/
# DB_NAME/DB_USER/DB_PASS entirely (db.ts:23-25).

# ACTIVE — Direct connection.
DATABASE_URL=postgresql://postgres:vFGeWWZon7CWwtF8@db.mzrdwaicehbrdpveldwm.supabase.co:5432/postgres

# FALLBACK — Session pooler. Use this instead if the line above fails with
# ENETUNREACH / ETIMEDOUT / EAI_AGAIN: on the free tier the direct host is
# IPv6-only and most home and campus networks here are IPv4-only.
# Replace <region> with your project's real region from the Supabase
# dashboard (Connect -> Session pooler), then comment out the ACTIVE line
# above and uncomment this one. Note the user becomes postgres.<project-ref>.
# Session pooler (port 5432), NOT Transaction pooler (6543) —
# withTransaction() holds one client across BEGIN/COMMIT, which transaction
# mode cannot do.
#DATABASE_URL=postgresql://postgres.mzrdwaicehbrdpveldwm:vFGeWWZon7CWwtF8@aws-0-<region>.pooler.supabase.com:5432/postgres

# Supabase requires SSL. config.ts:26 turns it on automatically whenever
# DATABASE_URL is set, but ONLY while DB_SSL is unset — an explicit
# DB_SSL=false overrides the default and the connection is refused.
# LEAVE THIS COMMENTED OUT.
#DB_SSL=false

# ---------- Local PostgreSQL ----------
# db.ts ignores these while DATABASE_URL is set. They stay here because the
# test suites read DB_USER/DB_PASS for their OWN local connection and
# default to postgres/postgres, which is not the role this project uses.
# Deleting them breaks `npm test` without affecting the app.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=resumematch_ph
DB_USER=rmph
DB_PASS=rmph


# ============================================================
# 2 · SERVER
# ============================================================
PORT=4300

# The Angular dev server origin (ng serve), so the session cookie's CORS
# policy allows it. Not needed in production if the built Angular app is
# served from this same Node process (see server.ts).
ALLOW_ORIGIN=http://localhost:4200

# Signs the session cookie. MUST be changed to a long random string before
# going live — config.ts:67 refuses to start in production while this is
# still the development default, because the cookie would be forgeable.
SESSION_SECRET=rmph-dev-secret-change-in-production

# Echoes raw SQL error text to clients AND returns live email verification
# codes in API responses, so codes can be read without an inbox during
# development. config.ts:69 refuses to start in production with this on.
DEBUG=true

# Where applicant resume files are written. Defaults to server/uploads,
# which is outside any public web root and served only through the file
# route that checks who is asking. Leave blank unless you are moving it.
UPLOAD_DIR=

# Set NODE_ENV=production on a real deployment. It flips DEBUG and
# COOKIE_SECURE to safe defaults and enables the startup safety check
# above. Leave it unset (development) on your own machine.
#NODE_ENV=production


# ============================================================
# 3 · PRODUCTION HARDENING
# ============================================================
# Set BOTH to true when running behind an HTTPS reverse proxy (nginx,
# Caddy, a cloud host). TRUST_PROXY makes Express trust X-Forwarded-*
# headers so rate limiting sees real client IPs; COOKIE_SECURE marks the
# session cookie HTTPS-only. Leave false for plain-http local use.
TRUST_PROXY=false
COOKIE_SECURE=false


# ============================================================
# 4 · EMAIL — verification codes, password resets, notifications
# ============================================================
# Any SMTP service works; see SETUP.md for free options (Gmail app
# password, Brevo). Leave these blank during development: with DEBUG=true
# the 6-digit code is printed to the server console and shown in the page,
# so account verification works with no mail server at all.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# TLS mode. Defaults to true when SMTP_PORT is 465, false otherwise
# (config.ts:141), which is right for almost every provider. Only set this
# if your provider documents something unusual.
SMTP_SECURE=

# The From: header. Defaults to "ResumeMatch PH <SMTP_USER>".
MAIL_FROM=

# Public base URL used for the links INSIDE notification emails, e.g.
# https://resumematch.example.com. Defaults to http://localhost:PORT.
APP_URL=


# ============================================================
# 5 · READING AN UPLOADED RESUME (the AI)
# ============================================================
# Which reader turns an uploaded document into fields the engine can score.
#
#   rules   Pattern matching only (lib/parse-resume.ts). No AI, no network,
#           no key, and the applicant's document never leaves this server.
#           Reads plain single-column PDFs, .docx and .txt. Cannot read a
#           scan or a photo, and degrades on multi-column layouts.
#
#   gemini  Google's Gemini API (lib/extract.ts). Reads images and messy
#           layouts far better, but sends the document to a third party.
#           PINNED — no fallback. A failure stays a failure. The extraction
#           test suite pins this on purpose, because a suite testing Gemini
#           must observe Gemini's failures rather than have them quietly
#           answered by the other reader.
#
#   auto    GEMINI FIRST when GEMINI_API_KEY is set, with the rule-based
#           reader catching every way Gemini can fail — no key, exhausted
#           quota, network down, a reply that is not usable JSON, or a reply
#           that yields nothing. With no key it goes straight to rules.
#
# WHY auto AND NOT gemini: a pinned Gemini reader turns a quota limit or a
# dropped connection into a dead Upload page. With auto the applicant always
# gets a reading; the only difference is how good it is.
#
# The consent notice on /upload-resume is written from whichever reader will
# be TRIED FIRST, so an applicant is told their document may go to Google
# BEFORE they agree to it. Changing this value changes that notice.
RESUME_EXTRACTOR=auto

# Only needed for the gemini reader. FREE key at
# https://aistudio.google.com/apikey (Google AI Studio).
#
# WITHOUT A KEY: RESUME_EXTRACTOR=auto silently uses the rule-based reader,
# and the Upload & analyze page still works — it just cannot read scans or
# photos. Nothing else on the site is affected.
GEMINI_API_KEY=

# The extraction model. The free tier includes this one.
GEMINI_MODEL=gemini-2.5-flash

# API host. Only ever changed to point the tests at a dead address so a
# network failure can be forced. Leave blank in normal use.
GEMINI_BASE_URL=
