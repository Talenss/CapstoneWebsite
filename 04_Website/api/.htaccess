# The API. Nothing here should ever be listed or cached.
Options -Indexes
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "same-origin"
</IfModule>

# config.php and the shared library are includes, never requests.
<FilesMatch "^(config|_lib)\.php$">
  Require all denied
</FilesMatch>
